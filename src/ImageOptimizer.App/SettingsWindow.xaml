<Window x:Class="ImageOptimizer.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    Width="600" SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource AppWindowStyle}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBackgroundBrush}"
        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="Res_tore defaults" Click="OnRestoreDefaults" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource FlatButton}" Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
          <Button Style="{StaticResource AccentButton}" Content="Save" IsDefault="True" Click="OnSave" />
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel Margin="20,16,20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,28,0">
          <TextBlock Text="Enable" Style="{StaticResource SectionHeader}" />
          <CheckBox x:Name="Avif" Content="_AVIF" />
          <CheckBox x:Name="Gif" Content="_GIF" />
          <CheckBox x:Name="Jpeg" Content="_JPEG" />
          <CheckBox x:Name="JpegXl" Content="JPEG _XL" />
          <CheckBox x:Name="Png" Content="_PNG" />
          <CheckBox x:Name="Svg" Content="_SVG" />
          <CheckBox x:Name="WebP" Content="_WebP" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Options" Style="{StaticResource SectionHeader}" />
          <CheckBox x:Name="StripMetadata" Content="_Remove metadata (EXIF, comments, camera info)"
              AutomationProperties.HelpText="{Binding Text, ElementName=StripMetadataHint}" />
          <TextBlock x:Name="StripMetadataHint" Text="Color profiles and photo orientation are always kept, so images look the same."
                Style="{StaticResource HintText}" Margin="22,0,0,6" />
          <CheckBox x:Name="MaximumCompression" Content="_Maximum compression (much slower)"
              AutomationProperties.HelpText="{Binding Text, ElementName=MaximumCompressionHint}" />
          <TextBlock x:Name="MaximumCompressionHint" Text="Uses Zopfli for PNG, the highest effort for lossless WebP, AVIF and JPEG XL, and multipass SVGO."
                Style="{StaticResource HintText}" Margin="22,0,0,6" />
          <CheckBox x:Name="AllowProgressiveJpeg" Content="_Use progressive JPEG when it's smaller" />
          <CheckBox x:Name="PreserveModifiedDate" Content="_Keep each file's original &quot;Date modified&quot;" />
          <CheckBox x:Name="CheckForUpdates" Content="_Check for updates when the app starts" />
          <CheckBox x:Name="ExplorerMenu" Content="Add &quot;Optimize with Image Optimizer&quot; to File _Explorer" Margin="0,6,0,0"
              AutomationProperties.HelpText="{Binding Text, ElementName=ExplorerMenuHint}" />
          <TextBlock x:Name="ExplorerMenuHint" Text="Right-click images or folders to optimize them. On Windows 11 it's under &quot;Show more options&quot;."
                Style="{StaticResource HintText}" Margin="22,0,0,6" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0">
        Files are replaced in place only when the result is smaller and (for bitmaps) every pixel is identical.
        Otherwise the original is left untouched.
      </TextBlock>
      <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
            Text="Powered by oxipng, libjpeg-turbo, libwebp, libavif, libjxl, Gifsicle and SVGO." />
      <TextBlock Style="{StaticResource HintText}" FontSize="11"
            HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0">
        <Run x:Name="VersionLabel" /><Run x:Name="VersionSeparator" Text=" · " /><Hyperlink
            Style="{StaticResource SubtleLink}" NavigateUri="https://github.com/coliff/image-optimizer-app"
            RequestNavigate="OnRequestNavigate" ToolTip="https://github.com/coliff/image-optimizer-app"
            AutomationProperties.Name="Image Optimizer on GitHub">GitHub</Hyperlink>
      </TextBlock>
    </StackPanel>
  </DockPanel>
</Window>