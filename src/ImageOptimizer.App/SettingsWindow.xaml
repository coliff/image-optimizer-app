<Window x:Class="ImageOptimizer.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    Width="420" SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource AppWindowStyle}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBackgroundBrush}"
        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="Restore defaults" Click="OnRestoreDefaults" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource FlatButton}" Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
          <Button Style="{StaticResource AccentButton}" Content="Save" IsDefault="True" Click="OnSave" />
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Margin="20,16,20,16">
      <TextBlock Text="Optimize these formats" Style="{StaticResource SectionHeader}" />
      <UniformGrid Columns="4" Margin="0,0,0,14">
        <CheckBox x:Name="Avif" Content="AVIF" />
        <CheckBox x:Name="Gif" Content="GIF" />
        <CheckBox x:Name="Jpeg" Content="JPEG" />
        <CheckBox x:Name="JpegXl" Content="JPEG XL" />
        <CheckBox x:Name="Png" Content="PNG" />
        <CheckBox x:Name="Svg" Content="SVG" />
        <CheckBox x:Name="WebP" Content="WebP" />
      </UniformGrid>

      <TextBlock Text="Options" Style="{StaticResource SectionHeader}" />
      <CheckBox x:Name="StripMetadata" Content="Remove metadata (EXIF, comments, camera info)" />
      <TextBlock Text="Color profiles and photo orientation are always kept, so images look the same."
            Style="{StaticResource HintText}" Margin="22,0,0,6" />

      <CheckBox x:Name="MaximumCompression" Content="Maximum compression (much slower)" />
      <TextBlock Text="Uses Zopfli for PNG, the highest effort for lossless WebP, AVIF and JPEG XL, and multipass SVGO."
            Style="{StaticResource HintText}" Margin="22,0,0,6" />

      <CheckBox x:Name="AllowProgressiveJpeg" Content="Allow progressive JPEG when it's smaller" />
      <CheckBox x:Name="PreserveModifiedDate" Content="Keep each file's original &quot;Date modified&quot;" />
      <CheckBox x:Name="CheckForUpdates" Content="Check for updates when the app starts" />

      <CheckBox x:Name="ExplorerMenu" Content="Add &quot;Optimize with Image Optimizer&quot; to File Explorer" Margin="0,6,0,0" />
      <TextBlock Text="Right-click images or folders to optimize them. On Windows 11 it's under &quot;Show more options&quot;."
            Style="{StaticResource HintText}" Margin="22,0,0,6" TextWrapping="Wrap" />

      <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0">
        Files are replaced in place only when the result is smaller and (for bitmaps) every pixel is identical.
        Otherwise the original is left untouched.
      </TextBlock>
      <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
            Text="Powered by oxipng, libjpeg-turbo, libwebp, libavif, libjxl, Gifsicle and SVGO." />
      <TextBlock x:Name="VersionLabel" Style="{StaticResource HintText}" FontSize="11"
            HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
