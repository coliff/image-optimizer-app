<Window x:Class="ImageOptimizer.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ImageOptimizer.App"
    Title="{x:Static local:Strings.Settings}"
    Width="600" SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource AppWindowStyle}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBackgroundBrush}"
        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="{x:Static local:Strings.RestoreDefaults}" Click="OnRestoreDefaults" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource FlatButton}" Content="{x:Static local:Strings.Cancel}" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
          <Button Style="{StaticResource AccentButton}" Content="{x:Static local:Strings.Save}" IsDefault="True" Click="OnSave" />
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel Margin="20,16,20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,28,0">
          <TextBlock Text="{x:Static local:Strings.EnableHeader}" Style="{StaticResource SectionHeader}" />
          <CheckBox x:Name="Avif" Content="_AVIF" />
          <CheckBox x:Name="Gif" Content="_GIF" />
          <CheckBox x:Name="Jpeg" Content="_JPEG" />
          <CheckBox x:Name="JpegXl" Content="JPEG _XL" />
          <CheckBox x:Name="Png" Content="_PNG" />
          <CheckBox x:Name="Svg" Content="_SVG" />
          <CheckBox x:Name="WebP" Content="_WebP" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{x:Static local:Strings.OptionsHeader}" Style="{StaticResource SectionHeader}" />
          <CheckBox x:Name="StripMetadata" Content="{x:Static local:Strings.StripMetadata}"
              AutomationProperties.HelpText="{Binding Text, ElementName=StripMetadataHint}" />
          <TextBlock x:Name="StripMetadataHint" Text="{x:Static local:Strings.StripMetadataHint}"
                Style="{StaticResource HintText}" Margin="22,0,0,6" />
          <CheckBox x:Name="MaximumCompression" Content="{x:Static local:Strings.MaximumCompression}"
              AutomationProperties.HelpText="{Binding Text, ElementName=MaximumCompressionHint}" />
          <TextBlock x:Name="MaximumCompressionHint" Text="{x:Static local:Strings.MaximumCompressionHint}"
                Style="{StaticResource HintText}" Margin="22,0,0,6" />
          <CheckBox x:Name="AllowProgressiveJpeg" Content="{x:Static local:Strings.AllowProgressiveJpeg}" />
          <CheckBox x:Name="PreserveModifiedDate" Content="{x:Static local:Strings.PreserveModifiedDate}" />
          <CheckBox x:Name="CheckForUpdates" Content="{x:Static local:Strings.CheckForUpdates}" />
          <CheckBox x:Name="ExplorerMenu" Content="{x:Static local:Strings.ExplorerMenu}" Margin="0,6,0,0"
              AutomationProperties.HelpText="{Binding Text, ElementName=ExplorerMenuHint}" />
          <TextBlock x:Name="ExplorerMenuHint" Text="{x:Static local:Strings.ExplorerMenuHint}"
                Style="{StaticResource HintText}" Margin="22,0,0,6" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
      <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0"
            Text="{x:Static local:Strings.SafetyNote}" />
      <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
            Text="{x:Static local:Strings.PoweredBy}" />
      <TextBlock Style="{StaticResource HintText}" FontSize="11"
            HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0">
        <Run x:Name="VersionLabel" /><Run x:Name="VersionSeparator" Text=" · " /><Hyperlink
            Style="{StaticResource SubtleLink}" NavigateUri="https://github.com/coliff/image-optimizer-app"
            RequestNavigate="OnRequestNavigate" ToolTip="https://github.com/coliff/image-optimizer-app"
            AutomationProperties.Name="{x:Static local:Strings.GitHubLinkName}">GitHub</Hyperlink>
      </TextBlock>
    </StackPanel>
  </DockPanel>
</Window>