<Window x:Class="ImageOptimizer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ImageOptimizer.App"
    Title="Image Optimizer"
    Width="640" Height="440" MinWidth="460" MinHeight="280"
    WindowStartupLocation="CenterScreen"
    Icon="Assets/ImageOptimizer.ico"
    Style="{StaticResource AppWindowStyle}"
    AllowDrop="True"
    DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
    PreviewKeyDown="OnPreviewKeyDown">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Geometry x:Key="CheckGeometry">M4.6,8.3 L7,10.6 L11.4,5.6</Geometry>

    <DataTemplate x:Key="QueuedIcon">
      <Ellipse Width="12" Height="12" Stroke="{DynamicResource NeutralBrush}" StrokeThickness="1.5" />
    </DataTemplate>
    <DataTemplate x:Key="WorkingIcon">
      <Ellipse Style="{StaticResource Spinner}" />
    </DataTemplate>
    <DataTemplate x:Key="OptimizedIcon">
      <Grid Width="16" Height="16">
        <Ellipse Fill="{DynamicResource SuccessBrush}" />
        <Path Data="{StaticResource CheckGeometry}" Stroke="{DynamicResource OnBadgeBrush}" StrokeThickness="1.8"
           StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="AlreadyOptimizedIcon">
      <Grid Width="16" Height="16">
        <Ellipse Fill="{DynamicResource NeutralBrush}" />
        <Path Data="{StaticResource CheckGeometry}" Stroke="{DynamicResource OnBadgeBrush}" StrokeThickness="1.8"
           StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SkippedIcon">
      <Grid Width="16" Height="16">
        <Ellipse Fill="{DynamicResource NeutralBrush}" />
        <Path Data="M5,8 L11,8" Stroke="{DynamicResource OnBadgeBrush}" StrokeThickness="1.8"
           StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="FailedIcon">
      <Grid Width="16" Height="16">
        <Ellipse Fill="{DynamicResource DangerBrush}" />
        <Path Data="M5.6,5.6 L10.4,10.4 M10.4,5.6 L5.6,10.4" Stroke="{DynamicResource OnBadgeBrush}" StrokeThickness="1.8"
           StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Grid>
    </DataTemplate>

    <Style x:Key="StatusIcon" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ContentTemplate" Value="{StaticResource QueuedIcon}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static local:FileStatus.Working}">
          <Setter Property="ContentTemplate" Value="{StaticResource WorkingIcon}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static local:FileStatus.Optimized}">
          <Setter Property="ContentTemplate" Value="{StaticResource OptimizedIcon}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static local:FileStatus.AlreadyOptimized}">
          <Setter Property="ContentTemplate" Value="{StaticResource AlreadyOptimizedIcon}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static local:FileStatus.Skipped}">
          <Setter Property="ContentTemplate" Value="{StaticResource SkippedIcon}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static local:FileStatus.Failed}">
          <Setter Property="ContentTemplate" Value="{StaticResource FailedIcon}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SubtleCell" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource SelectionSubtleTextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FileRow" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="ToolTip" Value="{Binding ToolTip}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource InsetFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" MinHeight="30" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AlternateRowBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Column headers -->
    <Border Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid Height="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="92" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Content="{Binding FileHeader}"
            Tag="{x:Static local:SortColumn.File}" ToolTip="Sort by name" Click="OnSortClick" />
        <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Content="{Binding SizeHeader}"
            HorizontalContentAlignment="Right" Padding="0,0,12,0"
            Tag="{x:Static local:SortColumn.Size}" ToolTip="Sort by size" Click="OnSortClick" />
        <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Content="{Binding SavingsHeader}"
            HorizontalContentAlignment="Right" Padding="0,0,16,0"
            Tag="{x:Static local:SortColumn.Savings}" ToolTip="Sort by savings" Click="OnSortClick" />
      </Grid>
    </Border>

    <ListBox x:Name="FileList" Grid.Row="1"
         ItemsSource="{Binding FilesView}"
         ItemContainerStyle="{StaticResource FileRow}"
         AlternationCount="2"
         SelectionMode="Extended"
         BorderThickness="0"
         Background="{DynamicResource ListBackgroundBrush}"
         HorizontalContentAlignment="Stretch"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         VirtualizingPanel.IsVirtualizing="True"
         VirtualizingPanel.VirtualizationMode="Recycling"
         MouseDoubleClick="OnRowDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type local:FileItem}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="96" />
              <ColumnDefinition Width="92" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource StatusIcon}" Content="{Binding}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,12,0" Style="{StaticResource SubtleCell}" />
            <TextBlock Grid.Column="3" Text="{Binding SavingsText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,16,0" FontWeight="SemiBold" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Show in folder" InputGestureText="Enter" Click="OnShowInFolder" />
          <MenuItem Header="Remove from list" InputGestureText="Del" Click="OnRemoveSelected" />
          <Separator />
          <MenuItem Header="Clear finished" Click="OnClearFinished" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>

    <!-- Empty state -->
    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
      <Image Source="Assets/Logo.png" Width="64" Height="64" Opacity="0.9" Margin="0,0,0,14"
          RenderOptions.BitmapScalingMode="HighQuality" />
      <TextBlock Text="Drop images here" FontSize="20" HorizontalAlignment="Center" />
      <TextBlock Text="AVIF, GIF, JPEG, JPEG XL, PNG, SVG and WebP files are optimized in place."
            Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
    </StackPanel>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{DynamicResource FooterBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}"
        BorderThickness="0,1,0,0" Padding="10,8">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE710;"
            AutomationProperties.Name="Add images" AutomationProperties.AcceleratorKey="Ctrl+O"
            ToolTip="Add images (Ctrl+O)" Click="OnAddFiles" />
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" Margin="6,0,0,0"
            AutomationProperties.Name="Settings" AutomationProperties.AcceleratorKey="Ctrl+,"
            ToolTip="Settings (Ctrl+,)" Click="OnOpenSettings" />
        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Restart to update" Margin="0,0,6,0"
            ToolTip="{Binding UpdateVersion, StringFormat='Version {0} is ready. It also installs the next time you open Image Optimizer.'}"
            Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}"
            IsEnabled="{Binding CanRestartToUpdate}" Click="OnRestartToUpdate" />
        <TextBlock x:Name="SummaryText" Text="{Binding Summary}" AutomationProperties.LiveSetting="Polite"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              TextTrimming="CharacterEllipsis" Margin="12,0" Foreground="{DynamicResource SubtleTextBrush}" />
      </DockPanel>
    </Border>

    <!-- Drag-and-drop highlight -->
    <Border x:Name="DropHighlight" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False"
        Background="{DynamicResource DropHighlightBrush}" BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="2" CornerRadius="4" Margin="3" />
  </Grid>
</Window>
