<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only: exercises the WPF pixel verifier against the real optimizers. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageOptimizer.App\ImageOptimizer.App.csproj" />
    <ProjectReference Include="..\..\src\ImageOptimizer.Core\ImageOptimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ImageOptimizer.Core.Tests\ToolRequirements.cs" Link="ToolRequirements.cs" />
    <Compile Include="..\ImageOptimizer.Core.Tests\Translations.cs" Link="Translations.cs" />
    <None Include="..\ImageOptimizer.Core.Tests\Fixtures\**" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
